# ============================================================================
# RELICON ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!
#
# Quick setup: cp .env.local.template .env.local
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required for database functionality)
# ============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
#
# 1. Create a Supabase project at https://supabase.com
# 2. Run the SQL schema from supabase-schema.sql
# 3. Get your project URL and API keys from Settings > API
#
# Used for:
# - Waitlist signups (/join-waitlist)
# - Contact form (/contact)
# - User authentication (when enabled)
# - Storing generated video metadata
# ============================================================================

# Your Supabase project URL
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anonymous/Public Key (safe for client-side)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS...
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (server-side only, bypasses RLS)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS...
# WARNING: Keep this secret! Never expose to client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# AI SERVICES (Required for video generation)
# ============================================================================

# ----------------------------------------------------------------------------
# OpenAI API (Required)
# ----------------------------------------------------------------------------
# Get from: https://platform.openai.com/api-keys
#
# Used for:
# - Campaign planning and strategy
# - Video script generation
# - Scene-by-scene blueprint creation
#
# Pricing: ~$0.10-0.20 per video
# Model: GPT-4o
# ----------------------------------------------------------------------------
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# Luma AI (Required)
# ----------------------------------------------------------------------------
# Get from: https://lumalabs.ai/dream-machine/api
#
# Used for:
# - Primary video generation
# - 9:16 aspect ratio (TikTok/Instagram format)
# - Ray-2 model at 720p resolution
#
# Pricing: $0.40 per 5-second clip (3 clips = ~$1.20 per video)
# Generation time: 2-5 minutes per scene
# ----------------------------------------------------------------------------
LUMA_API_KEY=

# ----------------------------------------------------------------------------
# ElevenLabs API (Required)
# ----------------------------------------------------------------------------
# Get from: https://elevenlabs.io/app/settings/api-keys
#
# Used for:
# - AI voiceover generation (text-to-speech)
# - Background music generation
# - Audio mixing and enhancement
#
# Pricing: Varies by subscription plan
# Free tier: 10,000 characters/month
# ----------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# ----------------------------------------------------------------------------
# Hailuo AI (Optional - Fallback video provider)
# ----------------------------------------------------------------------------
# Get from: Hailuo AI platform
#
# Used as backup if Luma AI fails or is unavailable
# Leave empty if you don't have access
# ----------------------------------------------------------------------------
HAILUO_API_KEY=

# ============================================================================
# PROVIDER CONFIGURATION (Optional)
# ============================================================================
# Override the default AI providers
# Only change if you want to use different providers
# ============================================================================

# Video generation provider: "luma" or "hailuo"
VIDEO_PROVIDER=luma

# Audio generation provider: "elevenlabs"
AUDIO_PROVIDER=elevenlabs

# Text generation provider: "openai"
TEXT_PROVIDER=openai

# ============================================================================
# SOCIAL MEDIA INTEGRATION (Required for posting & analytics)
# ============================================================================
# Keys for Instagram, Facebook, and TikTok integration
# See SOCIAL_MEDIA_INTEGRATION.md for setup instructions
# ============================================================================

# ----------------------------------------------------------------------------
# Meta (Facebook & Instagram)
# ----------------------------------------------------------------------------
# Get from: https://developers.facebook.com
# Create a Business app and enable Facebook Login + Instagram Graph API
#
# Used for:
# - Publishing videos to Instagram Reels and Facebook
# - Fetching post analytics (likes, comments, shares, views)
# - Managing connected accounts
# ----------------------------------------------------------------------------
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/social/callback/meta

# Webhook verify token (generate random string)
META_WEBHOOK_VERIFY_TOKEN=

# ----------------------------------------------------------------------------
# TikTok
# ----------------------------------------------------------------------------
# Get from: https://developers.tiktok.com
# Create an app and enable Login Kit + Marketing API
#
# Used for:
# - Publishing videos to TikTok
# - Fetching video analytics
# - Managing TikTok accounts
# ----------------------------------------------------------------------------
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5000/api/social/callback/tiktok

# Webhook verify token (generate random string)
TIKTOK_WEBHOOK_VERIFY_TOKEN=

# ============================================================================
# CRON JOB CONFIGURATION (Required for automated analytics sync)
# ============================================================================
# Security token for Vercel cron jobs
# Generate with: openssl rand -hex 32
# ============================================================================

# Secret token to authenticate cron job requests
# This prevents unauthorized access to the analytics sync endpoint
# Used by: /api/cron/sync-analytics
CRON_SECRET=

# ============================================================================
# ENGINE CONFIGURATION (Optional)
# ============================================================================
# Configuration for the FastAPI backend engine
# ============================================================================

# URL where the FastAPI backend is running
# Default: http://localhost:8000
# Production: Your deployed backend URL (e.g., https://api.relicon.com)
ENGINE_URL=http://localhost:8000

# Admin API key for protected endpoints
# Generate a secure random string: openssl rand -hex 32
# Used for: Admin analytics, waitlist exports, etc.
ADMIN_API_KEY=

# ============================================================================
# DEVELOPMENT SETTINGS (Optional)
# ============================================================================
# These are useful during development but can be removed in production
# ============================================================================

# Enable debug logging in the engine
DEBUG=false

# Skip video generation and use mock data (for UI testing)
MOCK_VIDEO_GENERATION=false

# Override video generation timeout (seconds)
# Default: 1800 (30 minutes)
# VIDEO_GENERATION_TIMEOUT=1800

# ============================================================================
# PRODUCTION SETTINGS (Optional)
# ============================================================================
# Only needed when deploying to production
# ============================================================================

# Your production domain (for CORS, redirects, etc.)
# NEXT_PUBLIC_APP_URL=https://relicon.com

# Vercel Analytics (if deployed on Vercel)
# Automatically enabled on Vercel, no config needed

# Sentry DSN for error tracking (if using Sentry)
# SENTRY_DSN=

# ============================================================================
# AUTHENTICATION (Future - not yet implemented)
# ============================================================================
# These will be used when Supabase Auth is enabled
# ============================================================================

# JWT Secret (auto-generated by Supabase)
# SUPABASE_JWT_SECRET=

# Site URL for auth redirects
# NEXT_PUBLIC_SITE_URL=http://localhost:5000

# ============================================================================
# STORAGE CONFIGURATION (Future - not yet implemented)
# ============================================================================
# For storing generated videos in cloud storage
# ============================================================================

# AWS S3 / Cloudflare R2 (for production video storage)
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=

# Supabase Storage (alternative to S3)
# Already configured via SUPABASE_* variables above
# Bucket name: generated-videos

# ============================================================================
# SETUP CHECKLIST
# ============================================================================
# Before running the app, make sure you have:
#
# Core Requirements:
# ✓ Copied this file to .env.local
# ✓ Created a Supabase project and ran both SQL schemas:
#   - supabase-schema.sql (core tables)
#   - supabase-social-schema.sql (social media & analytics)
# ✓ Added all three SUPABASE_* variables
# ✓ Obtained OpenAI API key (required)
# ✓ Obtained Luma AI API key (required)
# ✓ Obtained ElevenLabs API key (required)
#
# Social Media Integration (optional but recommended):
# ✓ Created Meta (Facebook) developer app
# ✓ Added META_APP_ID and META_APP_SECRET
# ✓ Created TikTok developer app
# ✓ Added TIKTOK_CLIENT_KEY and TIKTOK_CLIENT_SECRET
# ✓ Generated CRON_SECRET (openssl rand -hex 32)
#
# Optional:
# ✓ Generated an ADMIN_API_KEY (openssl rand -hex 32)
#
# Test your setup:
# 1. pnpm dev (start frontend)
# 2. cd engine && python server.py (start backend)
# 3. Visit http://localhost:5000
# 4. Try the waitlist form to test Supabase
# 5. Try Creative Studio to test video generation
# 6. Connect social accounts in Settings
# 7. Publish a video to test social media integration
# 8. Check Analytics dashboard for metrics
#
# ============================================================================
